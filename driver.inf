;
; TSCDriver.inf - WDM kernel driver installation
;

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
CatalogFile=TSCDriver.cat
DriverVer=06/10/2026,1.0.0.0
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
TSCDriver.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%TSCDriver.DeviceDesc%=TSCDriver_Device, Root\TSCDriver

[TSCDriver_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
TSCDriver.sys

;-------------- Service installation
[TSCDriver_Device.NT.Services]
AddService = TSCDriver,%SPSVCINST_ASSOCSERVICE%, TSCDriver_Service_Inst

[TSCDriver_Service_Inst]
DisplayName    = %TSCDriver.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\TSCDriver.sys

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName       = "TSCDriver"
DiskName               = "TSCDriver Installation Disk"
TSCDriver.DeviceDesc   = "TSCDriver Device"
TSCDriver.SVCDESC      = "TSCDriver Service"
